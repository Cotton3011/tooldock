---
interface Props { name: string; size?: number; strokeWidth?: number; }
const { name, size = 28, strokeWidth = 1.8 } = Astro.props;
---
<svg class:list={["mini-illustration", `icon-${name}`]} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <circle cx="25" cy="7" r="4" fill="var(--icon-pop)" />
  <path d="m5 25 3-6 3 6Z" fill="var(--icon-warm)" />
  <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
    {name === 'TextCursorInput' && <><rect x="5" y="8" width="22" height="16" rx="4" fill="var(--icon-soft)"/><path d="M9 13h14M9 18h8M12 11v10"/></>}
    {name === 'Megaphone' && <><path d="m6 16 14-7v14L6 17Z" fill="var(--icon-soft)"/><path d="M20 13h3a3 3 0 0 1 0 6h-3M9 18l2 7h5l-2-9"/><path d="M24 8l2-2M25 24l2 2"/></>}
    {name === 'CalendarDays' && <><rect x="5" y="7" width="22" height="20" rx="4" fill="var(--icon-soft)"/><path d="M10 5v5m12-5v5M5 12h22"/><rect x="9" y="16" width="6" height="6" rx="1" fill="var(--icon-pop)" stroke="none"/><path d="M18 17h5m-5 4h4"/></>}
    {name === 'Image' && <><rect x="5" y="6" width="22" height="20" rx="4" fill="var(--icon-soft)"/><circle cx="11" cy="12" r="2" fill="var(--icon-warm)"/><path d="m7 23 7-7 4 4 3-3 4 5"/><path d="M3 11V4h7M22 28h7v-7"/></>}
    {name === 'Timer' && <><rect x="5" y="9" width="22" height="17" rx="5" fill="var(--icon-soft)"/><path d="M12 5h8m-4 0v4"/><path d="M10 16h3v4h-3zm6 0h3v4h-3zm6 0h2v4h-2" fill="var(--icon-pop)"/></>}
    {name === 'Lightbulb' && <><path d="M10 19a9 9 0 1 1 12 0c-2 1.6-2 3-2 4h-8c0-1 0-2.4-2-4Z" fill="var(--icon-soft)"/><path d="M12 26h8M16 2V0M5 7 3 5m24 2 2-2"/><path d="m13 14 2 2 4-5"/></>}
    {name === 'MessageCircle' && <><path d="M5 7h22v16H15l-6 5v-5H5Z" fill="var(--icon-soft)"/><path d="M10 13h12m-12 5h7"/><circle cx="24" cy="8" r="3" fill="var(--icon-pop)" stroke="none"/></>}
    {name === 'Clock' && <><rect x="5" y="7" width="22" height="20" rx="4" fill="var(--icon-soft)"/><path d="M5 12h22M10 5v5m12-5v5"/><circle cx="17" cy="19" r="5" fill="white"/><path d="M17 16v3l2 1"/></>}
    {name === 'Hash' && <><rect x="5" y="7" width="22" height="19" rx="4" fill="var(--icon-soft)"/><path d="m12 11-2 11m8-11-2 11M8 15h13M7 19h13"/><path d="M23 11h2m-2 4h2m-3 4h3"/></>}
    {name === 'Target' && <><circle cx="15" cy="17" r="11" fill="var(--icon-soft)"/><circle cx="15" cy="17" r="6"/><circle cx="15" cy="17" r="2" fill="var(--icon-pop)"/><path d="m17 15 9-9m-4 0h4v4"/></>}
    {name === 'Search' && <><rect x="5" y="7" width="19" height="20" rx="4" fill="var(--icon-soft)"/><path d="M9 12h11M9 17h7"/><circle cx="21" cy="21" r="5" fill="white"/><path d="m25 25 4 4"/><path d="m18.5 21 1.5 1.5 3-3"/></>}
    {name === 'TextQuote' && <><path d="M5 8h22v17H10l-5 4Z" fill="var(--icon-soft)"/><path d="M10 13h12m-12 5h9"/><path d="M10 11v9"/></>}
    {name === 'Braces' && <><rect x="5" y="6" width="22" height="21" rx="4" fill="var(--icon-soft)"/><path d="M13 10h-2v4l-2 2 2 2v4h2m6-12h2v4l2 2-2 2v4h-2"/><circle cx="16" cy="16" r="2" fill="var(--icon-pop)" stroke="none"/></>}
    {name === 'WandSparkles' && <><path d="m7 25 14-14 4 4-14 14Z" fill="var(--icon-soft)"/><path d="m19 13 4 4M9 6v5M6.5 8.5h5M23 3v5m-2.5-2.5h5"/><path d="m22 23 1 2 2 1-2 1-1 2-1-2-2-1 2-1Z" fill="var(--icon-pop)"/></>}
    {name === 'Dices' && <><rect x="4" y="10" width="15" height="15" rx="4" fill="var(--icon-soft)"/><rect x="14" y="5" width="14" height="14" rx="4" fill="white"/><circle cx="18" cy="9" r="1" fill="currentColor" stroke="none"/><circle cx="24" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="9" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="14" cy="20" r="1" fill="currentColor" stroke="none"/></>}
  </g>
</svg>

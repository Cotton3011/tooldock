---
interface Props { type: string; }
const { type } = Astro.props;
---
<svg class:list={["card-visual-svg", `composition-${type}`]} viewBox="0 0 320 132" fill="none" aria-hidden="true">
  {type === 'headline' && <><rect x="18" y="21" width="284" height="90" rx="10" class="panel"/><text x="35" y="48" class="micro">配信タイトル</text><text x="35" y="78" class="display">今夜のゲーム配信</text><path d="M35 92h164" class="line"/><path d="M212 56v31" class="cursor"/><rect x="228" y="55" width="54" height="28" rx="6" class="chip"/><text x="255" y="74" class="chip-text">生成</text></>}
  {type === 'post' && <><rect x="53" y="13" width="214" height="108" rx="14" class="paper"/><circle cx="78" cy="40" r="11" class="accent-fill"/><path d="M73 40h10M78 35v10" class="white-line"/><path d="M100 35h70M100 45h42M73 67h154M73 80h125M73 93h91" class="line"/><path d="m244 22 25 13-25 13z" class="accent-fill"/><circle cx="275" cy="22" r="13" class="alert"/><text x="275" y="26" class="alert-text">1</text></>}
  {type === 'calendar' && <><rect x="25" y="17" width="270" height="103" rx="12" class="paper"/><path d="M25 43h270M68 17v26M252 17v26" class="strong-line"/><g class="day-label"><text x="43" y="35">月</text><text x="83" y="35">火</text><text x="123" y="35">水</text><text x="163" y="35">木</text><text x="203" y="35">金</text><text x="243" y="35">土</text><text x="278" y="35">日</text></g><g class="calendar-grid"><path d="M64 43v77M103 43v77M142 43v77M181 43v77M220 43v77M259 43v77M25 69h270M25 94h270"/></g><rect x="108" y="51" width="29" height="11" rx="3" class="accent-fill"/><rect x="186" y="76" width="29" height="11" rx="3" class="accent-fill"/><rect x="69" y="101" width="29" height="11" rx="3" class="accent-fill"/></>}
  {type === 'crop' && <><rect x="18" y="24" width="126" height="84" rx="7" class="panel"/><path d="m27 96 35-34 21 19 17-15 35 30" class="image-line"/><circle cx="109" cy="47" r="8" class="accent-fill"/><path d="M154 66h22m-8-8 8 8-8 8" class="strong-line"/><rect x="187" y="17" width="115" height="98" rx="8" class="paper"/><rect x="202" y="31" width="85" height="70" class="crop-frame"/><path d="M202 48V31h17M270 31h17v17M202 84v17h17M270 101h17V84" class="handle"/></>}
  {type === 'timer' && <><rect x="25" y="15" width="270" height="102" rx="13" class="dark-panel"/><circle cx="47" cy="35" r="5" class="live"/><text x="61" y="39" class="live-text">LIVE OVERLAY</text><text x="160" y="83" class="digital">05:00</text><circle cx="137" cy="101" r="9" class="control"/><path d="m135 96 7 5-7 5z" class="dark-fill"/><circle cx="163" cy="101" r="9" class="control"/><path d="M160 97v8m6-8v8" class="dark-line"/></>}
  {type === 'note' && <><rect x="54" y="34" width="112" height="77" rx="9" class="paper tilted-back"/><rect x="93" y="18" width="120" height="84" rx="9" class="paper tilted-front"/><path d="M119 42h67M119 56h49M119 70h58" class="line"/><circle cx="236" cy="77" r="31" class="dice"/><circle cx="226" cy="67" r="3" class="dark-fill"/><circle cx="246" cy="87" r="3" class="dark-fill"/><path d="M34 29c0-13 10-22 22-22s22 9 22 22c0 9-6 13-10 18H44c-4-5-10-9-10-18Zm12 26h20" class="bulb"/></>}
  {type === 'chat' && <><path d="M24 25h151v58H74l-27 23V83H24z" class="bubble-one"/><path d="M127 53h169v55H270l-18 16v-16H127z" class="bubble-two"/><path d="M48 46h91M48 60h68M151 73h112M151 87h79" class="line"/><rect x="210" y="18" width="69" height="25" rx="5" class="note"/><path d="M220 27h48M220 35h31" class="note-line"/></>}
  {type === 'timeline' && <><text x="30" y="34" class="micro">START</text><text x="222" y="34" class="micro">END</text><text x="27" y="64" class="time">20:00</text><text x="219" y="64" class="time">22:30</text><path d="M50 91h220" class="timeline"/><circle cx="55" cy="91" r="11" class="paper strong-line"/><circle cx="265" cy="91" r="11" class="accent-fill"/><path d="m145 80 14 11-14 11" class="strong-line"/><path d="M55 84v7l5 3M265 84v7l5 3" class="clock-line"/></>}
  {type === 'tags' && <><text x="22" y="27" class="micro">BEFORE</text><rect x="20" y="38" width="82" height="25" rx="12" class="messy"/><text x="61" y="55" class="tag-text">VTuber</text><rect x="64" y="70" width="96" height="25" rx="12" class="messy"/><text x="112" y="87" class="tag-text"># 雑談</text><path d="M172 67h28m-9-9 9 9-9 9" class="strong-line"/><text x="213" y="27" class="micro">AFTER</text><rect x="211" y="38" width="88" height="25" rx="12" class="tag"/><text x="255" y="55" class="tag-text">#VTuber</text><rect x="211" y="70" width="88" height="25" rx="12" class="tag"/><text x="255" y="87" class="tag-text">#ゲーム配信</text></>}
  {type === 'progress' && <><circle cx="83" cy="66" r="42" class="gauge-bg"/><circle cx="83" cy="66" r="42" class="gauge" pathLength="100"/><text x="83" y="73" class="percent">72%</text><text x="159" y="38" class="micro">STREAM GOAL</text><text x="159" y="67" class="goal-number">720 / 1000</text><rect x="159" y="82" width="128" height="12" rx="6" class="gauge-track"/><rect x="159" y="82" width="92" height="12" rx="6" class="accent-fill"/></>}
  {type === 'registry' && <><rect x="20" y="18" width="280" height="33" rx="9" class="search-box"/><circle cx="39" cy="34" r="7" class="search-circle"/><path d="m44 39 6 6M62 34h124" class="line"/><rect x="48" y="65" width="224" height="55" rx="10" class="paper registry-card"/><circle cx="76" cy="92" r="16" class="avatar"/><path d="M68 98c2-9 14-9 16 0M71 88h10" class="avatar-line"/><text x="103" y="86" class="registry-name">VTuber NAME</text><text x="103" y="103" class="registry-no">登録番号 #0128</text><circle cx="253" cy="77" r="14" class="verified"/><path d="m246 77 5 5 9-10" class="white-line"/></>}
</svg>

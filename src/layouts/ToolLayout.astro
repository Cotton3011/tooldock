---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import ToolCard from '../components/ToolCard.astro';
import toolsData from '../data/tools.json';
import { categories, categoryPaths, type Tool } from '../lib/tool-types';
import ToolIcon from '../components/ToolIcon.astro';
interface Props { tool: Tool; }
const { tool } = Astro.props;
const allTools = toolsData as Tool[];
const relatedIds = tool.relatedTools ?? [];
const related = allTools.filter((item) => item.enabled && item.id !== tool.id).sort((a, b) => Number(relatedIds.includes(b.id)) - Number(relatedIds.includes(a.id)) || Number(b.category === tool.category) - Number(a.category === tool.category)).slice(0, 4);
const pageTitle = tool.id === 'name-checker' ? 'VTuber名前検索・登録チェッカー｜名前・読み方を無料検索 | VToolDock' : tool.category === 'vtuber' ? `${tool.name}｜VTuber・配信者向け無料ツール | VToolDock` : `${tool.name}｜無料・ブラウザ完結 - VToolDock`;
const ogImage = tool.id === 'name-checker' ? '/og/vtuber-name-checker.png' : tool.category === 'vtuber' ? '/og/vtuber-tools.png' : '/og/vtooldock.png';
const privacyNote = tool.id === 'name-checker' ? '検索・登録・通報データはCloudflare上で安全に処理します。' : '入力データは外部へ送信されません。';
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: tool.faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site) },
  { '@type': 'ListItem', position: 2, name: categories[tool.category], item: new URL(categoryPaths[tool.category], Astro.site) },
  { '@type': 'ListItem', position: 3, name: tool.name, item: new URL(tool.path, Astro.site) },
] };
---
<BaseLayout title={pageTitle} description={tool.description} canonical={tool.path} ogImage={ogImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="tool-page container">
    <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/">ホーム</a><span>/</span><a href={categoryPaths[tool.category]}>{categories[tool.category]}</a><span>/</span><span>{tool.name}</span></nav>
    <header class="tool-heading">
      <span class:list={["tool-heading-icon", `category-${tool.category}`]}><ToolIcon name={tool.icon} size={30} /></span>
      <div><span class="eyebrow">{categories[tool.category]}</span>
      <h1>{tool.name}</h1>
      <p>{tool.description}{privacyNote}</p></div>
    </header>
    <AdSlot />
    <p class="back-to-category"><a href={categoryPaths[tool.category]}>← {categories[tool.category]}の一覧へ戻る</a></p>
    <section class="tool-surface" aria-label={`${tool.name} 操作画面`}><slot name="tool" /></section>
    <div class="article-grid">
      <article class="content-card">
        <h2>使い方</h2>
        <slot name="usage" />
      </article>
      <article class="content-card">
        <h2>主な用途</h2>
        <ul>{tool.uses.map((use) => <li>{use}</li>)}</ul>
      </article>
    </div>
    <AdSlot />
    <section class="section-block">
      <div class="section-heading"><div><span class="eyebrow">OTHER TOOLS</span><h2>関連ツール</h2></div></div>
      <div class="tool-grid compact">{related.map((item) => <ToolCard tool={item} />)}</div>
    </section>
    <section class="section-block faq-section">
      <div class="section-heading"><div><span class="eyebrow">FAQ</span><h2>よくある質問</h2></div></div>
      <div class="faq-list">{tool.faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    </section>
  </div>
</BaseLayout>

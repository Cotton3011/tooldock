---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import AdSlot from '../components/AdSlot.astro';
import toolsData from '../data/tools.json';
import { categories, categoryPaths, type CategoryId, type Tool } from '../lib/tool-types';
import { vtuberSections } from '../lib/vtuber-sections';

export function getStaticPaths() {
  const slugToId: Record<string, CategoryId> = { vtuber: 'vtuber', image: 'image', text: 'text', developer: 'development', random: 'random' };
  return Object.keys(slugToId).map((category) => ({ params: { category }, props: { categoryId: slugToId[category] } }));
}
const { categoryId } = Astro.props as { categoryId: CategoryId };
const allTools = (toolsData as Tool[]).filter((tool) => tool.enabled);
const tools = allTools.filter((tool) => tool.category === categoryId);
const isVtuber = categoryId === 'vtuber';
const description = isVtuber
  ? 'VTuber・配信者のYouTube配信やTwitch配信を支える無料の配信ツール集です。OBS、配信素材、告知、企画に役立つ便利ツールをブラウザで使えます。'
  : `${categories[categoryId]}に関する無料Webツールの一覧です。登録不要でブラウザから利用できます。`;
const relatedCategories = (Object.keys(categories) as CategoryId[]).filter((id) => id !== categoryId);
const categoryVisuals: Record<CategoryId, { src: string; alt: string }> = {
  vtuber: { src: '/illustrations/vtuber-guide.webp', alt: '配信画面とコメント管理を案内するVToolDockオリジナル配信者キャラクター' },
  image: { src: '/illustrations/image-guide.webp', alt: '画像のトリミングと書き出しを案内するVToolDockオリジナル画像編集キャラクター' },
  text: { src: '/illustrations/text-guide.webp', alt: '文章編集と文字数確認を案内するVToolDockオリジナル編集者キャラクター' },
  development: { src: '/illustrations/developer-guide.webp', alt: 'コードとJSONツールを案内するVToolDockオリジナル開発者キャラクター' },
  random: { src: '/illustrations/random-guide.webp', alt: 'ルーレットと抽選を案内するVToolDockオリジナル司会者キャラクター' },
};
const categoryVisual = categoryVisuals[categoryId];
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site) },
  { '@type': 'ListItem', position: 2, name: categories[categoryId], item: new URL(categoryPaths[categoryId], Astro.site) },
] };
---
<BaseLayout title={`${categories[categoryId]}の無料Webツール一覧 | VToolDock`} description={description} canonical={categoryPaths[categoryId]} ogImage={isVtuber ? '/og/vtuber-tools.png' : '/og/vtooldock.png'}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class:list={["category-page", "container", isVtuber && "vtuber-category"]}>
    <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/">ホーム</a><span>/</span><span>{categories[categoryId]}</span></nav>
    <header class:list={["category-hero", "illustrated-category"]}>
      <div class="category-visual"><img src={categoryVisual.src} width="720" height="480" alt={categoryVisual.alt} loading="eager" decoding="async" /></div>
      <span class="eyebrow">{isVtuber ? 'FOR STREAMERS' : 'CATEGORY'}</span>
      <h1>{categories[categoryId]}</h1>
      <p>{description}</p>
      {isVtuber && <div class="keyword-pills"><span>OBS</span><span>YouTube配信</span><span>Twitch配信</span><span>配信素材</span></div>}
    </header>
    {isVtuber && <nav class="directory-tabs" aria-label="VTuberツール分類"><a class="active" href="/vtuber/">総合</a>{Object.values(vtuberSections).map((section)=><a href={section.path}>{section.name}</a>)}</nav>}
    {isVtuber && <section class="section-block directory-grid">{Object.values(vtuberSections).map((section)=><a href={section.path}><span class="eyebrow">{section.tools.length} TOOLS</span><h2>{section.name}</h2><p>{section.description}</p><b>一覧を見る →</b></a>)}</section>}
    {isVtuber && <section class="section-block"><div class="section-heading"><div><span class="eyebrow">POPULAR</span><h2>人気の配信便利ツール</h2></div></div><div class="tool-grid">{tools.filter((tool) => tool.popular).map((tool) => <ToolCard tool={tool} />)}</div></section>}
    <AdSlot />
    <section class="section-block"><div class="section-heading"><div><span class="eyebrow">NEW</span><h2>新着ツール</h2></div></div><div class="new-list">{tools.filter((tool) => tool.isNew).slice(0, 4).map((tool, index) => <a href={tool.path}><span>0{index + 1}</span><div><strong>{tool.name}</strong><small>{tool.description}</small></div><b>→</b></a>)}</div></section>
    {!isVtuber && <section class="section-block"><div class="section-heading"><div><span class="eyebrow">ALL TOOLS</span><h2>すべてのツール</h2></div><p>{tools.length}個</p></div>{tools.length ? <div class="tool-grid">{tools.map((tool) => <ToolCard tool={tool} />)}</div> : <p class="empty-category">このカテゴリの新しいツールを準備中です。</p>}</section>}
    <section class="section-block"><div class="section-heading"><div><span class="eyebrow">RELATED</span><h2>関連カテゴリ</h2></div></div><div class="category-links">{relatedCategories.map((id) => <a href={categoryPaths[id]}>{categories[id]}<span>→</span></a>)}</div></section>
  </div>
</BaseLayout>

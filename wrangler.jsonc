{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tooldock",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tooldock-vtuber",
    "database_id": "679f615a-6522-4752-9798-231eae993648",
    "migrations_dir": "migrations"
  }]
}
